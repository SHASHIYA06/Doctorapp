# ============================================================================
# CLINICAL SAAS ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in the actual values
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=Doctor App
VITE_APP_VERSION=0.1.0

# API Port (for local development)
API_PORT=3000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL (Recommended for production)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/clinical_saas

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# GEMINI AI INTEGRATION
# ============================================================================

# Google Gemini API Key (for Clinical Decision Support)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=2048

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment
NODE_ENV=development

# Log Level
LOG_LEVEL=debug

# Request Timeout (in ms)
REQUEST_TIMEOUT=30000

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# SendGrid (for emails) - Optional
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@doctorapp.com

# Stripe (for payments) - Optional
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Twilio (for SMS/Voice) - Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# HEALTHCARE DATA
# ============================================================================

# Medicine Database
MEDICINE_DATABASE_PATH=./data/medicines.json
MEDICINE_API_ENDPOINT=https://api.medicinedatabase.com

# Clinical Guidelines
CLINICAL_GUIDELINES_PATH=./data/guidelines/

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================

# Sentry (Error Tracking) - Optional
SENTRY_DSN=

# PostHog (Product Analytics) - Optional
POSTHOG_API_KEY=

# ============================================================================
# FILE STORAGE
# ============================================================================

# AWS S3 (for file uploads) - Optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=doctor-app-uploads
AWS_S3_REGION=us-east-1

# Or use local file storage
FILE_STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@doctorapp.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_CDS_ENABLED=true
FEATURE_TELEMEDICINE_ENABLED=true
FEATURE_PRESCRIPTION_AUTOMATION=true
FEATURE_REAL_TIME_MESSAGING=true
FEATURE_DARK_MODE=false

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# Mock Data
USE_MOCK_DATA=true

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
