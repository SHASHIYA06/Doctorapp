# Vercel Build Ignore File
# Files and directories to ignore during Vercel builds

# Dependencies
node_modules/
.pnpm-store/

# Build outputs (keep only what we need)
dist/
build/
.next/

# Development files
.git/
.gitignore
.env.local
.env.*.local

# Testing
coverage/
test/
__tests__/
*.test.ts
*.spec.ts

# Documentation
README.md
DEPLOYMENT_GUIDE.md
DATABASE_SETUP.md
VERCEL_CHECKLIST.md
DEPLOYMENT_SUMMARY.md
docs/
infra/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Source files we don't need at runtime (keep compiled output)
src/
tsconfig.json
vite.config.ts
tsconfig.*.json

# Other
.prettierrc
.eslintrc*
.gitattributes
LICENSE

# Monorepo specific
apps/api/
apps/patient-web/
apps/voice-gateway/
packages/
services/
