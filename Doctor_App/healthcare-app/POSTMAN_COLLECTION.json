    {
      "name": "Complaints",
      "item": [
        {
          "name": "Submit Complaint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set(\"complaintId\", jsonData.complaint.id);",
                  "  pm.environment.set(\"consultationId\", jsonData.complaint.consultationId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chiefComplaint\": \"Chest pain\",\n  \"symptoms\": \"Sharp pain in chest when breathing, shortness of breath\",\n  \"duration\": \"2 days\",\n  \"severity\": \"severe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints/submit",
